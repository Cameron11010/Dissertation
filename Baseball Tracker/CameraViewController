    // MARK: - Camera Setup
    func setupCamera() {
        print("🎥 setupCamera() called on thread: \(Thread.current)")

        guard let device = AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back) else {
            print("❌ ERROR: Could not get camera device")
            return
        }
        print("✅ Got camera device: \(device.localizedName)")

        // ── 1. Configure device format BEFORE touching the session ──────────
        // lockForConfiguration must NOT be called inside beginConfiguration/commitConfiguration.
        func maxFPS(for format: AVCaptureDevice.Format) -> Double {
            format.videoSupportedFrameRateRanges.map { $0.maxFrameRate }.max() ?? 0
        }

        let globalMaxFPS = device.formats.map { maxFPS(for: $0) }.max() ?? 0
        print("[Camera] \(device.formats.count) formats, max fps: \(globalMaxFPS)")

        let preferredDims: [(Int32, Int32)] = [(1920, 1080), (1080, 1920), (1280, 720), (720, 1280)]
        let highFPSFormats = device.formats.filter { maxFPS(for: $0) == globalMaxFPS }

        let chosenFormat: AVCaptureDevice.Format? = {
            for (w, h) in preferredDims {
                if let f = highFPSFormats.first(where: {
                    let d = CMVideoFormatDescriptionGetDimensions($0.formatDescription)
                    return d.width == w && d.height == h
                }) { return f }
            }
            return highFPSFormats.first
        }()

        if let fmt = chosenFormat {
            let fps = maxFPS(for: fmt)
            let dims = CMVideoFormatDescriptionGetDimensions(fmt.formatDescription)
            print("[Camera] Chose \(dims.width)×\(dims.height) @ \(fps) fps")
            do {
                try device.lockForConfiguration()
                device.activeFormat = fmt
                self.activeDimensions = dims
                if let range = fmt.videoSupportedFrameRateRanges.first(where: { $0.maxFrameRate == fps }) {
                    let dur = CMTimeMake(value: 1, timescale: Int32(fps.rounded()))
                    device.activeVideoMinFrameDuration = dur
                    device.activeVideoMaxFrameDuration = dur
                }
                device.unlockForConfiguration()
                let dur = device.activeVideoMaxFrameDuration
                self.activeFrameRate = dur.seconds > 0 ? 1.0 / dur.seconds : fps
                print("[Camera] Active: \(self.activeDimensions.width)×\(self.activeDimensions.height) @ \(self.activeFrameRate) fps")
            } catch {
                print("[Camera] lockForConfiguration failed: \(error)")
            }
        }

        // ── 2. Build capture session ──────────────────────────────────────
        do {
            videoDeviceInput = try AVCaptureDeviceInput(device: device)
        } catch {
            print("[Camera] AVCaptureDeviceInput error: \(error)")
            return
        }

        captureSession.beginConfiguration()
        captureSession.sessionPreset = .inputPriority

        guard captureSession.canAddInput(videoDeviceInput) else {
            print("[Camera] Cannot add video input")
            captureSession.commitConfiguration()
            return
        }
        captureSession.addInput(videoDeviceInput)

        videoOutput = AVCaptureVideoDataOutput()
        videoOutput.videoSettings = [
            kCVPixelBufferPixelFormatTypeKey as String: Int(kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange)
        ]
        videoOutput.alwaysDiscardsLateVideoFrames = true   // prevent queue build-up at 240fps
        videoOutput.setSampleBufferDelegate(self, queue: videoQueue)

        guard captureSession.canAddOutput(videoOutput) else {
            print("[Camera] Cannot add video output")
            captureSession.commitConfiguration()
            return
        }
        captureSession.addOutput(videoOutput)

        // Set portrait orientation on the connection.
        if let connection = videoOutput.connection(with: .video) {
            if #available(iOS 17.0, *) {
                if connection.isVideoRotationAngleSupported(90) {
                    connection.videoRotationAngle = 90
                }
            } else {
                if connection.isVideoOrientationSupported {
                    connection.videoOrientation = .portrait
                }
            }
        }
        self.mirrored = (device.position == .front)
        self.contentFlippedVertically = false

        captureSession.commitConfiguration()

        // ── 3. Start running & add preview layer ──────────────────────────
        captureSession.startRunning()
        print("[Camera] Session running: \(captureSession.isRunning)")

        DispatchQueue.main.async { [weak self] in
            guard let self = self else { return }
            let preview = AVCaptureVideoPreviewLayer(session: self.captureSession)
            preview.videoGravity = .resizeAspectFill
            preview.frame = self.view.bounds
            self.previewLayer = preview
            self.view.layer.insertSublayer(preview, at: 0)
            self.view.layer.insertSublayer(self.overlayLayer, above: preview)
            print("[Camera] Preview layer added, overlay above preview")
        }
    }
    
    // MARK: - Navigation Helpers
    func dismissToRootAndPresentAlert(_ alert: UIAlertController) {
        DispatchQueue.main.async {
            let presentAlert = {
                if let root = self.view.window?.rootViewController {
                    var top = root
                    while let presented = top.presentedViewController { top = presented }
                    top.present(alert, animated: true)
                } else {
                    self.topMostViewController().present(alert, animated: true)
                }
            }
            if let nav = self.navigationController {
                nav.popToRootViewController(animated: true)
                nav.dismiss(animated: true) {
                    presentAlert()
                }
            } else if let presenting = self.presentingViewController {
                var rootPresenter = presenting
                while let p = rootPresenter.presentingViewController { rootPresenter = p }
                rootPresenter.presentedViewController?.dismiss(animated: true) {
                    presentAlert()
                }
            } else {
                self.view.window?.rootViewController?.dismiss(animated: true) {
                    presentAlert()
                }
            }
        }
    }
    
    // MARK: - Permissions Helper
    func ensurePhotoLibraryPermission(completion: @escaping (Bool) -> Void) {
        let status = PHPhotoLibrary.authorizationStatus(for: .addOnly)
        switch status {
        case .authorized, .limited:
            completion(true)
        case .notDetermined:
            PHPhotoLibrary.requestAuthorization(for: .addOnly) { newStatus in
                DispatchQueue.main.async {
                    completion(newStatus == .authorized || newStatus == .limited)
                }
            }
        default:
            completion(false)
        }
    }
}

// MARK: - UIViewController extension for safe alert presentation
extension UIViewController {
    func topMostViewController() -> UIViewController {
        var top = self
        while let presented = top.presentedViewController {
            top = presented
        }
        return top
    }
}
