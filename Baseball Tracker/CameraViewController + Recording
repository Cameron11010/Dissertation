//
//  CameraViewController+Recording.swift
//  Baseball Tracker
//
//  Start / stop H.264 live recording via AVAssetWriter.
//
//  All writer objects (assetWriter, assetWriterInput, pixelBufferAdaptor) are
//  created on the main thread before isRecording is set, so captureOutput always
//  sees a fully-initialised writer.
//
//  isRecording is set to true/false DIRECTLY (synchronously) on the main thread,
//  NOT via videoQueue.async. This ensures captureOutput (on videoQueue) will
//  see isRecording=true on its very next invocation after startCustomRecording returns.
//  Using videoQueue.async would allow a rapid start→stop to queue both flag flips
//  back-to-back, so captureOutput never runs with isRecording=true in between.
//

import UIKit
import AVFoundation
import Photos

extension CameraViewController {

    // MARK: - Start

    func startCustomRecording() {
        guard !isRecording else { return }

        // Camera buffers come out portrait-rotated (connection sets 90° rotation),
        // so the delivered pixel buffers are already portrait even though
        // activeDimensions reports the native landscape sensor size (e.g. 1920×1080).
        // We must use the connection's actual output dimensions, not activeDimensions.
        // The simplest safe approach: always write at the buffer's natural portrait size.
        let videoWidth  = Int(min(activeDimensions.width, activeDimensions.height))
        let videoHeight = Int(max(activeDimensions.width, activeDimensions.height))

        let outputURL = URL(fileURLWithPath: NSTemporaryDirectory())
            .appendingPathComponent(UUID().uuidString + ".mov")

        guard let writer = try? AVAssetWriter(outputURL: outputURL, fileType: .mov) else {
            print("[Recording] Failed to create AVAssetWriter")
            return
        }

        let videoSettings: [String: Any] = [
            AVVideoCodecKey:  AVVideoCodecType.h264,
            AVVideoWidthKey:  videoWidth,
            AVVideoHeightKey: videoHeight,
            AVVideoCompressionPropertiesKey: [
                AVVideoAverageBitRateKey:          25_000_000,
                AVVideoExpectedSourceFrameRateKey: Int(activeFrameRate),
                AVVideoProfileLevelKey:            AVVideoProfileLevelH264HighAutoLevel,
                AVVideoAllowFrameReorderingKey:    false
            ] as [String: Any]
        ]

        let writerInput = AVAssetWriterInput(mediaType: .video, outputSettings: videoSettings)
        writerInput.expectsMediaDataInRealTime = true

        let adaptor = AVAssetWriterInputPixelBufferAdaptor(
            assetWriterInput: writerInput,
            sourcePixelBufferAttributes: [
                kCVPixelBufferPixelFormatTypeKey as String: Int(kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange),
                kCVPixelBufferWidthKey  as String: videoWidth,
                kCVPixelBufferHeightKey as String: videoHeight
            ]
        )

        guard writer.canAdd(writerInput) else {
            print("[Recording] Cannot add writer input")
            return
        }
        writer.add(writerInput)

        // Store all writer objects before flipping isRecording.
        assetWriter        = writer
        assetWriterInput   = writerInput
        pixelBufferAdaptor = adaptor
        recordingStartTime = nil
        lastFrameTime      = nil
        frameCount         = 0

        // Reset tracking data.
        detectionMarkers.removeAll()
        skeletonFrames.removeAll()
        poseHistory.removeAll()
        fusedFrameData.removeAll()
        lastPoseObservation           = nil
        videoRotationDegrees          = 0
        ballEverDetectedThisRecording = false
        consecutiveFramesWithoutBall  = 0
        currentROI                    = nil
        framesWithoutDetection        = 0

        // Set isRecording on videoQueue synchronously (blocking main thread until done).
        // This guarantees the flag is visible to captureOutput before this method returns,
        // eliminating the data race between the main-thread write and videoQueue read.
        // Using sync (not async) also prevents a rapid start→stop from queueing both
        // flag flips back-to-back with no captureOutput call in between.
        videoQueue.sync { self.isRecording = true }
        updateRecordButton(isRecording: true)
        onRecordingStateChanged?(true)

        print("[Recording] Starting \(videoWidth)×\(videoHeight) @ \(activeFrameRate) fps H.264 25 Mbps — isRecording=true")
    }

    // MARK: - Stop

    func stopCustomRecording() {
        guard isRecording else { return }

        // Set isRecording=false on videoQueue synchronously so captureOutput stops
        // appending frames. By blocking until the sync completes, we ensure no new
        // frames are being written before we proceed to finalise the writer.
        videoQueue.sync { self.isRecording = false }
        updateRecordButton(isRecording: false)
        onRecordingStateChanged?(false)

        // Finalise the writer on videoQueue. By the time this block runs, all
        // in-flight captureOutput calls have completed (videoQueue is serial and
        // isRecording=false has already been set), so recordingStartTime reflects
        // its final value and no new frames will be appended.
        videoQueue.async { [weak self] in
            guard let self = self else { return }

            let writer    = self.assetWriter
            let input     = self.assetWriterInput
            let startTime = self.recordingStartTime

            guard let writer, let input else {
                print("[Recording] No writer to finalise")
                return
            }

            guard startTime != nil else {
                print("[Recording] No frames were captured — discarding")
                self.assetWriter        = nil
                self.assetWriterInput   = nil
                self.pixelBufferAdaptor = nil
                return
            }

            input.markAsFinished()
            writer.finishWriting { [weak self] in
                guard let self = self else { return }
                let url = writer.outputURL
                print("[Recording] Finished writing: \(url.lastPathComponent)  status=\(writer.status.rawValue)")
                self.saveBiomechanicalDataToFile()

                // Clear writer objects only after the file is complete.
                self.assetWriter        = nil
                self.assetWriterInput   = nil
                self.pixelBufferAdaptor = nil
                self.recordingStartTime = nil

                DispatchQueue.main.async {
                    self.showProcessingOverlay(message: "Adding annotations to video…")
                }
                Task {
                    await self.postProcessVideoWithAnnotations(rawVideoURL: url)
                }
            }
        }
    }

    // MARK: - Save to Photos

    func saveToPhotosThenAlert(outputURL: URL) {
        Task { @MainActor in
            await withCheckedContinuation { continuation in
                self.ensurePhotoLibraryPermission { granted in
                    Task { @MainActor in
                        guard granted else {
                            let alert = UIAlertController(
                                title: "Photos Access Denied",
                                message: "Video exported but cannot save to Photos. Enable access in Settings.",
                                preferredStyle: .alert)
                            alert.addAction(UIAlertAction(title: "OK", style: .default))
                            self.dismissToRootAndPresentAlert(alert)
                            continuation.resume()
                            return
                        }
                        var localIdentifier: String?
                        PHPhotoLibrary.shared().performChanges({
                            if let ph = PHAssetChangeRequest
                                .creationRequestForAssetFromVideo(atFileURL: outputURL)?
                                .placeholderForCreatedAsset {
                                localIdentifier = ph.localIdentifier
                            }
                        }) { success, _ in
                            Task { @MainActor in
                                if success, let id = localIdentifier {
                                    self.onVideoSaved?(id)
                                    let alert = UIAlertController(title: "Saved", message: "Annotated video saved to Photos.", preferredStyle: .alert)
                                    alert.addAction(UIAlertAction(title: "OK", style: .default))
                                    self.dismissToRootAndPresentAlert(alert)
                                } else {
                                    self.onVideoSaved?("")
                                    let alert = UIAlertController(title: "Save Failed", message: "Could not save video. Check permissions and storage.", preferredStyle: .alert)
                                    alert.addAction(UIAlertAction(title: "OK", style: .default))
                                    self.dismissToRootAndPresentAlert(alert)
                                }
                                continuation.resume()
                            }
                        }
                    }
                }
            }
        }
    }
}
