    }
    
    // MARK: - Draw Calibration Overlay
    func drawCalibrationOverlay(bufferSize: CGSize) {
        // Build screen-space positions for each of the 5 plate points.
        let screenPoints: [CGPoint] = settings.platePoints.map { normalised in
            CGPoint(x: normalised.x * bufferSize.width,
                    y: normalised.y * bufferSize.height)
        }

        let allValid = screenPoints.allSatisfy { $0 != .zero }

        if allValid && screenPoints.count == 5 {
            // Draw the pentagon outline
            let platePath = UIBezierPath()
            platePath.move(to: screenPoints[0])
            for i in 1..<5 { platePath.addLine(to: screenPoints[i]) }
            platePath.close()

            let plateLayer = CAShapeLayer()
            plateLayer.path = platePath.cgPath
            plateLayer.strokeColor = UIColor.yellow.cgColor
            plateLayer.fillColor = UIColor.yellow.withAlphaComponent(0.06).cgColor
            plateLayer.lineWidth = 3
            plateLayer.lineCap = .round
            plateLayer.lineJoin = .round
            overlayLayer.addSublayer(plateLayer)

            // Draw a dot for each corner with its colour
            let markerColors: [UIColor] = [.systemGreen, .systemBlue, .systemOrange, .systemRed, .systemPurple]
            for (i, pt) in screenPoints.enumerated() {
                let size: CGFloat = 10
                let rect = CGRect(x: pt.x - size / 2, y: pt.y - size / 2, width: size, height: size)
                let dot = CAShapeLayer()
                dot.path = UIBezierPath(ovalIn: rect).cgPath
                dot.fillColor = markerColors[i].cgColor
                dot.strokeColor = UIColor.white.cgColor
                dot.lineWidth = 2
                overlayLayer.addSublayer(dot)
            }
        } else {
            // Fallback: draw the legacy two-point line (back edge only)
            let leftPos  = CGPoint(x: settings.plateLeftEdge.x  * bufferSize.width,
                                   y: settings.plateLeftEdge.y  * bufferSize.height)
            let rightPos = CGPoint(x: settings.plateRightEdge.x * bufferSize.width,
                                   y: settings.plateRightEdge.y * bufferSize.height)

            let linePath = UIBezierPath()
            linePath.move(to: leftPos)
            linePath.addLine(to: rightPos)

            let lineLayer = CAShapeLayer()
            lineLayer.path = linePath.cgPath
            lineLayer.strokeColor = UIColor.yellow.cgColor
            lineLayer.lineWidth = 3
            lineLayer.lineCap = .round
            overlayLayer.addSublayer(lineLayer)
        }

        // Width label at the midpoint of the back edge
        let leftPos  = allValid ? screenPoints[HomePlatePoint.backLeft.rawValue]
                                : CGPoint(x: settings.plateLeftEdge.x  * bufferSize.width,
                                          y: settings.plateLeftEdge.y  * bufferSize.height)
        let rightPos = allValid ? screenPoints[HomePlatePoint.backRight.rawValue]
                                : CGPoint(x: settings.plateRightEdge.x * bufferSize.width,
                                          y: settings.plateRightEdge.y * bufferSize.height)

        let midpoint = CGPoint(x: (leftPos.x + rightPos.x) / 2,
                               y: (leftPos.y + rightPos.y) / 2)
        let widthText = String(format: "%.1f%@", settings.plateWidth, settings.useCentimeters ? "cm" : "\"")

        let textLayer = CATextLayer()
        textLayer.string = widthText
        textLayer.foregroundColor = UIColor.white.cgColor
        textLayer.backgroundColor = UIColor.yellow.withAlphaComponent(0.8).cgColor
        textLayer.fontSize = 16
        textLayer.alignmentMode = .center
        textLayer.contentsScale = view.traitCollection.displayScale

        let textWidth: CGFloat = 80
        let textHeight: CGFloat = 28
        textLayer.frame = CGRect(x: midpoint.x - textWidth / 2,
                                 y: midpoint.y - textHeight / 2,
                                 width: textWidth,
                                 height: textHeight)
        textLayer.cornerRadius = 6
        overlayLayer.addSublayer(textLayer)
    }
    
    // MARK: - Strike Zone Overlay
    // The ABS strike zone width is defined by the right corner (pt 2) and left corner (pt 4)
    // of home plate — the 17" dimension across the widest part, not the back edge.
    func drawStrikeZone(bufferSize: CGSize) {
        // Prefer the dedicated corner points when a full 5-point calibration is available.
        let rightNorm: CGPoint
        let leftNorm: CGPoint

        if settings.platePoints.count == 5 &&
           settings.platePoints[HomePlatePoint.right.rawValue] != .zero &&
           settings.platePoints[HomePlatePoint.left.rawValue]  != .zero {
            rightNorm = settings.platePoints[HomePlatePoint.right.rawValue]
            leftNorm  = settings.platePoints[HomePlatePoint.left.rawValue]
        } else {
            rightNorm = settings.plateRightEdge
            leftNorm  = settings.plateLeftEdge
        }

        let left  = CGPoint(x: leftNorm.x  * bufferSize.width,  y: leftNorm.y  * bufferSize.height)
        let right = CGPoint(x: rightNorm.x * bufferSize.width,  y: rightNorm.y * bufferSize.height)

        let plateVec = CGPoint(x: right.x - left.x, y: right.y - left.y)
        let platePixels = sqrt(plateVec.x * plateVec.x + plateVec.y * plateVec.y)
        guard platePixels > 1 else { return }

        let plateInches: Double = settings.useCentimeters ? settings.plateWidth / 2.54 : settings.plateWidth
        let pixelsPerInch = platePixels / CGFloat(plateInches)

        let bottomOffsetPixels = pixelsPerInch * CGFloat(settings.strikeZoneBottomOffset)
        let zoneHeightPixels   = pixelsPerInch * CGFloat(settings.strikeZoneHeight)

        let bl = CGPoint(x: left.x,  y: left.y  - bottomOffsetPixels)
        let br = CGPoint(x: right.x, y: right.y - bottomOffsetPixels)
        let tl = CGPoint(x: left.x,  y: left.y  - bottomOffsetPixels - zoneHeightPixels)
        let tr = CGPoint(x: right.x, y: right.y - bottomOffsetPixels - zoneHeightPixels)

        let szColor = settings.strikeZoneColor.toUIColor()

        // Filled background
        let fillPath = UIBezierPath()
        fillPath.move(to: bl); fillPath.addLine(to: br); fillPath.addLine(to: tr); fillPath.addLine(to: tl); fillPath.close()
        let fillLayer = CAShapeLayer()
        fillLayer.path = fillPath.cgPath
        fillLayer.fillColor = szColor.withAlphaComponent(0.08).cgColor
        fillLayer.strokeColor = nil
        overlayLayer.addSublayer(fillLayer)

        // Outline
        let outlineLayer = CAShapeLayer()
        outlineLayer.path = fillPath.cgPath
        outlineLayer.fillColor = nil
        outlineLayer.strokeColor = szColor.withAlphaComponent(0.7).cgColor
        outlineLayer.lineWidth = 2.5
        outlineLayer.lineCap = .round
        outlineLayer.lineJoin = .round
        overlayLayer.addSublayer(outlineLayer)

        // Dashed centre line
        let midLeft  = CGPoint(x: (bl.x + tl.x) / 2, y: (bl.y + tl.y) / 2)
        let midRight = CGPoint(x: (br.x + tr.x) / 2, y: (br.y + tr.y) / 2)
        let midPath = UIBezierPath()
        midPath.move(to: midLeft); midPath.addLine(to: midRight)
        let midLayer = CAShapeLayer()
        midLayer.path = midPath.cgPath
        midLayer.fillColor = nil
        midLayer.strokeColor = szColor.withAlphaComponent(0.35).cgColor
        midLayer.lineWidth = 1.0
        midLayer.lineDashPattern = [6, 4]
        overlayLayer.addSublayer(midLayer)
    }
    
    // MARK: - Check Swing Indicator

    /// Draws a prominent "CHECK SWING" banner at the top of the frame when a check swing is detected.
    func drawCheckSwingIndicator(bufferSize: CGSize) {
        let bannerHeight: CGFloat = 48
        let bannerWidth: CGFloat = 240
        let bannerX = (bufferSize.width - bannerWidth) / 2
        let bannerY: CGFloat = 60

        let bgLayer = CAShapeLayer()
        bgLayer.path = UIBezierPath(roundedRect: CGRect(x: bannerX, y: bannerY,
                                                         width: bannerWidth, height: bannerHeight),
                                    cornerRadius: 10).cgPath
        bgLayer.fillColor = UIColor.systemOrange.withAlphaComponent(0.9).cgColor
        bgLayer.strokeColor = UIColor.white.withAlphaComponent(0.8).cgColor
        bgLayer.lineWidth = 2
        overlayLayer.addSublayer(bgLayer)

        let textLayer = CATextLayer()
        textLayer.string = "⚡ CHECK SWING"
        textLayer.foregroundColor = UIColor.white.cgColor
        textLayer.backgroundColor = UIColor.clear.cgColor
        textLayer.fontSize = 18
        textLayer.alignmentMode = .center
        textLayer.contentsScale = view.traitCollection.displayScale
        textLayer.frame = CGRect(x: bannerX, y: bannerY + (bannerHeight - 24) / 2,
                                 width: bannerWidth, height: 24)
        overlayLayer.addSublayer(textLayer)
    }

    // MARK: - Draw ROI Debug Box
    func drawROI(_ roi: CGRect, bufferSize: CGSize) {
        let roiRect = convertBoundingBox(roi, bufferSize: bufferSize, mirrored: mirrored, contentFlippedVertically: contentFlippedVertically)
        
        let roiPath = UIBezierPath(rect: roiRect)
        let roiLayer = CAShapeLayer()
        roiLayer.path = roiPath.cgPath
        roiLayer.strokeColor = UIColor.yellow.withAlphaComponent(0.8).cgColor
        roiLayer.fillColor = UIColor.yellow.withAlphaComponent(0.1).cgColor
        roiLayer.lineWidth = 3
        roiLayer.lineDashPattern = [10, 5]
        overlayLayer.addSublayer(roiLayer)
        
        let label = CATextLayer()
        label.string = "ROI (missed: \(framesWithoutDetection))"
        label.foregroundColor = UIColor.white.cgColor
        label.backgroundColor = UIColor.yellow.withAlphaComponent(0.8).cgColor
        label.fontSize = 14
        label.contentsScale = view.traitCollection.displayScale
        label.alignmentMode = .center
        label.frame = CGRect(x: roiRect.minX, y: roiRect.minY - 22, width: 140, height: 20)
        overlayLayer.addSublayer(label)
    }
