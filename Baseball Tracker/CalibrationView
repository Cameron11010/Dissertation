//
//  CalibrationView.swift
//  Baseball Tracker
//
//  5-point home plate calibration UI.
//  The user taps each of the 5 corners of home plate in this order:
//    1. Back-Left   2. Back-Right   3. Right Corner
//    4. Front Tip   5. Left Corner
//
//  The resulting image points, combined with the known world coordinates
//  stored in HomePlatePoint, are handed to HomographyHelper to compute
//  a ground-plane homography.
//

import SwiftUI
import AVFoundation

// MARK: - Calibration View
struct CalibrationView: View {
    @ObservedObject var settings: CameraSettings
    @Environment(\.dismiss) var dismiss
    var minimumZoom: CGFloat = 1.0
    var onDismiss: (() -> Void)?

    // Five image-space positions (nil = not yet placed)
    @State private var tappedPoints: [CGPoint?] = Array(repeating: nil, count: 5)
    @State private var tappedZooms:  [CGFloat]  = Array(repeating: 1.0, count: 5)

    @State private var calibrationZoom: CGFloat = 1.0
    @State private var zoomFactor: CGFloat = 1.0
    @State private var screenSize: CGSize = .zero

    // Which point the user is currently placing (nil = all done)
    private var nextPointIndex: Int? {
        tappedPoints.firstIndex(where: { $0 == nil })
    }

    var body: some View {
        GeometryReader { geometry in
            calibrationContent
                .onAppear {
                    screenSize = geometry.size
                    loadExistingCalibration()
                }
        }
    }

    private var calibrationContent: some View {
        ZStack {
            CalibrationCameraPreview(zoomFactor: $zoomFactor, minimumZoom: minimumZoom)
                .ignoresSafeArea()

            // Instruction banner
            VStack {
                VStack(spacing: 8) {
                    Text("Calibrate Home Plate")
                        .font(.largeTitle)
                        .fontWeight(.bold)
                        .foregroundColor(.white)

                    Text(instructionText)
                        .font(.headline)
                        .foregroundColor(.white)
                        .multilineTextAlignment(.center)
                        .padding(.horizontal)
                }
                .padding()
                .background(Color.black.opacity(0.65))

                Spacer()

                // Zoom indicator
                HStack {
                    Text(String(format: "%.1fx", zoomFactor))
                        .font(.subheadline)
                        .fontWeight(.semibold)
                        .foregroundColor(.white)
                        .padding(.horizontal, 12)
                        .padding(.vertical, 6)
                        .background(Color.black.opacity(0.6))
                        .cornerRadius(8)
                    Spacer()
                }
                .padding(.leading, 16)

                Spacer()

                // Point progress indicator
                HStack(spacing: 10) {
                    ForEach(HomePlatePoint.allCases, id: \.rawValue) { pt in
                        VStack(spacing: 4) {
                            Circle()
                                .fill(tappedPoints[pt.rawValue] != nil ? pt.color : Color.gray.opacity(0.4))
                                .frame(width: 16, height: 16)
                                .overlay(Circle().stroke(Color.white, lineWidth: 1))
                            Text(pt.label)
                                .font(.system(size: 9, weight: .semibold))
                                .foregroundColor(.white)
                        }
                    }
                }
                .padding(.vertical, 8)
                .padding(.horizontal, 16)
                .background(Color.black.opacity(0.55))
                .cornerRadius(10)
                .padding(.bottom, 4)

                // Action buttons
                VStack(spacing: 12) {
                    HStack(spacing: 12) {
                        Button { dismiss() } label: {
                            Text("Cancel").font(.headline).foregroundColor(.white)
                                .frame(maxWidth: .infinity).padding()
                                .background(Color.red.opacity(0.7)).cornerRadius(12)
                        }
                        Button { clearCalibration() } label: {
                            Text("Clear").font(.headline).foregroundColor(.white)
                                .frame(maxWidth: .infinity).padding()
                                .background(Color.orange.opacity(0.7)).cornerRadius(12)
                        }
                    }
                    Button { saveCalibration() } label: {
                        Text("Save").font(.headline).foregroundColor(.white)
                            .frame(maxWidth: .infinity).padding()
                            .background(canSave ? Color.green : Color.gray.opacity(0.5)).cornerRadius(12)
                    }
                    .disabled(!canSave)
                }
                .padding()
            }

            // Placed markers
            ForEach(HomePlatePoint.allCases, id: \.rawValue) { pt in
                if let pos = tappedPoints[pt.rawValue] {
                    CalibrationMarker(label: pt.label, color: pt.color)
                        .position(scaledPosition(pos, recordedAt: tappedZooms[pt.rawValue]))
                }
            }

            // Plate outline connecting all placed points in order
            plateOutlineView

            // Highlight ring for the next point to place
            if let idx = nextPointIndex, let pt = HomePlatePoint(rawValue: idx) {
                VStack {
                    Spacer()
                    Spacer()
                    Text("Tap: \(pt.label)")
                        .font(.headline)
                        .foregroundColor(pt.color)
                        .padding(.horizontal, 16)
                        .padding(.vertical, 8)
                        .background(Color.black.opacity(0.7))
                        .cornerRadius(10)
                    Spacer()
                        .frame(height: 220)
                }
            }
        }
        .contentShape(Rectangle())
        .gesture(
            DragGesture(minimumDistance: 0)
                .onEnded { value in handleTap(at: value.location) }
        )
        .simultaneousGesture(
            MagnificationGesture()
                .onChanged { scale in
                    let newZoom = calibrationZoom * scale
                    zoomFactor = min(max(newZoom, minimumZoom), 10.0)
                }
                .onEnded { _ in
                    calibrationZoom = max(zoomFactor, minimumZoom)
                }
        )
    }

    // MARK: - Plate Outline
    @ViewBuilder
    private var plateOutlineView: some View {
        // Collect the screen positions of all placed points in order
        let positions: [CGPoint] = HomePlatePoint.allCases.compactMap { pt in
            guard let pos = tappedPoints[pt.rawValue] else { return nil }
            return scaledPosition(pos, recordedAt: tappedZooms[pt.rawValue])
        }

        if positions.count >= 2 {
            Canvas { ctx, _ in
                var path = Path()
                path.move(to: positions[0])
                for i in 1..<positions.count {
                    path.addLine(to: positions[i])
                }
                if positions.count == 5 { path.closeSubpath() }
                ctx.stroke(path, with: .color(.yellow.opacity(0.8)), lineWidth: 3)
            }
            .allowsHitTesting(false)
        }
    }

    // MARK: - Helpers
    private func scaledPosition(_ position: CGPoint, recordedAt markerZoom: CGFloat) -> CGPoint {
        let center = CGPoint(x: screenSize.width / 2, y: screenSize.height / 2)
        let scale = zoomFactor / markerZoom
        return CGPoint(x: center.x + (position.x - center.x) * scale,
                       y: center.y + (position.y - center.y) * scale)
    }

    private var instructionText: String {
        guard let idx = nextPointIndex, let pt = HomePlatePoint(rawValue: idx) else {
            return "All 5 points placed. Pinch to verify, then tap Save."
        }
        let step = idx + 1
        return "Step \(step)/5 — Tap the \(pt.label) corner of home plate"
    }

    private var canSave: Bool {
        tappedPoints.allSatisfy { $0 != nil }
    }

    private func handleTap(at position: CGPoint) {
        if let idx = nextPointIndex {
            tappedPoints[idx] = position
            tappedZooms[idx] = zoomFactor
        } else {
            // All placed — reset and start again
            clearCalibration()
        }
    }

    private func clearCalibration() {
        tappedPoints = Array(repeating: nil, count: 5)
        tappedZooms  = Array(repeating: zoomFactor, count: 5)
        calibrationZoom = minimumZoom
        zoomFactor = minimumZoom
        settings.isCalibrated = false
        settings.platePoints  = Array(repeating: .zero, count: 5)
        settings.plateLeftEdge  = .zero
        settings.plateRightEdge = .zero
        onDismiss?()
    }

    private func loadExistingCalibration() {
        zoomFactor = minimumZoom
        calibrationZoom = minimumZoom

        if settings.isCalibrated {
            for i in 0..<5 {
                let normalised = settings.platePoints[i]
                tappedPoints[i] = CGPoint(x: normalised.x * screenSize.width,
                                          y: normalised.y * screenSize.height)
                tappedZooms[i] = minimumZoom
            }
        }
    }

    private func saveCalibration() {
        guard canSave else { return }

        let center = CGPoint(x: screenSize.width / 2, y: screenSize.height / 2)

        // Normalise all 5 points back to the minimum zoom level, then to 0–1
        var normalised: [CGPoint] = []
        for i in 0..<5 {
            let pos  = tappedPoints[i]!
            let zoom = tappedZooms[i]

            let atMinZoom = CGPoint(
                x: center.x + (pos.x - center.x) / zoom * minimumZoom,
                y: center.y + (pos.y - center.y) / zoom * minimumZoom
            )
            normalised.append(CGPoint(x: atMinZoom.x / screenSize.width,
                                      y: atMinZoom.y / screenSize.height))
        }

        settings.platePoints = normalised
        settings.isCalibrated = true

        // Derive legacy left/right edge from back-left and back-right
        // so that strike zone + overlay code still works without changes.
        settings.plateLeftEdge  = normalised[HomePlatePoint.backLeft.rawValue]
        settings.plateRightEdge = normalised[HomePlatePoint.backRight.rawValue]

        onDismiss?()
        dismiss()
    }
}

// MARK: - Calibration Marker
struct CalibrationMarker: View {
    let label: String
    let color: Color

    var body: some View {
        VStack(spacing: 4) {
            Circle()
                .fill(color)
                .frame(width: 20, height: 20)
                .overlay(Circle().stroke(Color.white, lineWidth: 2))

            Text(label)
                .font(.caption).fontWeight(.bold).foregroundColor(.white)
                .padding(.horizontal, 8).padding(.vertical, 4)
                .background(color.opacity(0.8)).cornerRadius(6)
        }
    }
}

// MARK: - Calibration Camera Preview
struct CalibrationCameraPreview: UIViewControllerRepresentable {
    @Binding var zoomFactor: CGFloat
    var minimumZoom: CGFloat = 1.0

    func makeUIViewController(context: Context) -> CalibrationCameraViewController {
        let vc = CalibrationCameraViewController()
        vc.zoomFactor = zoomFactor
        vc.minimumZoom = minimumZoom
        return vc
    }

    func updateUIViewController(_ uiViewController: CalibrationCameraViewController, context: Context) {
        uiViewController.updateZoom(to: zoomFactor)
    }
}

class CalibrationCameraViewController: UIViewController {
    private let captureSession = AVCaptureSession()
    private let sessionQueue = DispatchQueue(label: "calibration.camera.queue")
    private var previewLayer: AVCaptureVideoPreviewLayer!
    private var videoDeviceInput: AVCaptureDeviceInput?

    var zoomFactor: CGFloat = 1.0
    var minimumZoom: CGFloat = 1.0

    override func viewDidLoad() {
        super.viewDidLoad()
        view.backgroundColor = .black
        setupCamera()
    }

    override func viewDidLayoutSubviews() {
        super.viewDidLayoutSubviews()
        previewLayer?.frame = view.bounds
    }

    override func viewDidAppear(_ animated: Bool) {
        super.viewDidAppear(animated)
        sessionQueue.async { [weak self] in self?.captureSession.startRunning() }
    }

    override func viewWillDisappear(_ animated: Bool) {
        super.viewWillDisappear(animated)
        sessionQueue.async { [weak self] in self?.captureSession.stopRunning() }
    }

    private func setupCamera() {
        sessionQueue.async { [weak self] in
            guard let self = self else { return }
            self.captureSession.beginConfiguration()
            self.captureSession.sessionPreset = .high

            guard let device = AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back),
                  let input = try? AVCaptureDeviceInput(device: device) else {
                self.captureSession.commitConfiguration()
                return
            }

            self.videoDeviceInput = input
            if self.captureSession.canAddInput(input) { self.captureSession.addInput(input) }
            self.captureSession.commitConfiguration()

            DispatchQueue.main.async {
                let preview = AVCaptureVideoPreviewLayer(session: self.captureSession)
                preview.videoGravity = .resizeAspectFill
                preview.frame = self.view.bounds
                self.view.layer.insertSublayer(preview, at: 0)
                self.previewLayer = preview
            }

            self.updateZoom(to: self.minimumZoom)
        }
    }

    func updateZoom(to factor: CGFloat) {
        guard let device = videoDeviceInput?.device else { return }
        sessionQueue.async {
            do {
                try device.lockForConfiguration()
                let maxZoom = min(device.activeFormat.videoMaxZoomFactor, 10.0)
                let clampedFactor = max(self.minimumZoom, min(factor, maxZoom))
                device.videoZoomFactor = clampedFactor
                device.unlockForConfiguration()
            } catch {
                print("[Calibration Zoom] Error: \(error)")
            }
        }
    }
}
