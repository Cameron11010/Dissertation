import UIKit
import Vision
import CoreML

extension CameraViewController {
    
    // MARK: - Overlay & CoreML
    func setupOverlay() {
        overlayLayer.frame = view.bounds
        overlayLayer.backgroundColor = UIColor.clear.cgColor
        view.layer.addSublayer(overlayLayer)
    }
    
    func setupModel() {
        guard let modelURL = Bundle.main.url(forResource: "best_v2", withExtension: "mlmodelc"),
              let mlmodel = try? MLModel(contentsOf: modelURL),
              let visionModel = try? VNCoreMLModel(for: mlmodel) else {
            fatalError("Could not load CoreML model. Ensure 'best_v2.mlmodel' is added to your project.")
        }
        self.visionModel = visionModel
        
        let request = VNCoreMLRequest(model: visionModel) { [weak self] request, _ in
            guard let self = self else { return }
            let results = (request.results as? [VNRecognizedObjectObservation]) ?? []
            self.lastObservations = results
            
            // Debug: Log what ROI Vision is actually using
            if self.settings.showROI && self.settings.enableROI && self.frameCount % 30 == 0 {
                if let coreMLRequest = request as? VNCoreMLRequest {
                    let roi = coreMLRequest.regionOfInterest
                    print("[ROI Debug] Vision request ROI: x=\(String(format: "%.3f", roi.origin.x)) y=\(String(format: "%.3f", roi.origin.y)) w=\(String(format: "%.3f", roi.width)) h=\(String(format: "%.3f", roi.height))")
                    print("[ROI Debug] Got \(results.count) total results from Vision")
                }
            }
            
            // Use the user's confidence threshold consistently
            let effectiveThreshold = self.settings.ballConfidenceThreshold
            
            let baseballDetections = results.filter { obs in
                guard let label = obs.labels.first else { return false }
                
                let bbox = obs.boundingBox
                let isValidBox = bbox.minX >= -0.1 && bbox.maxX <= 1.1 &&
                                bbox.minY >= -0.1 && bbox.maxY <= 1.1 &&
                                bbox.width > 0.005 && bbox.width <= 0.5 &&
                                bbox.height > 0.005 && bbox.height <= 0.5
                
                if !isValidBox && self.settings.showROI {
                    print("[ROI] ⚠️ Rejecting invalid detection: bbox=\(bbox), conf=\(String(format: "%.2f", obs.confidence))")
                }
                
                let passed = label.identifier == "baseball" &&
                       obs.confidence >= effectiveThreshold &&
                       isValidBox
                
                if self.settings.showROI && self.settings.enableROI && self.frameCount % 30 == 0 {
                    if label.identifier == "baseball" {
                        let currentROIString = self.currentROI != nil ? String(format: "ROI(%.2f,%.2f %.2fx%.2f)", self.currentROI!.origin.x, self.currentROI!.origin.y, self.currentROI!.width, self.currentROI!.height) : "NO ROI"
                        print("[ROI Debug] Detection: conf=\(String(format: "%.2f", obs.confidence)) bbox=(\(String(format: "%.3f,%.3f %.3fx%.3f", bbox.origin.x, bbox.origin.y, bbox.width, bbox.height))) passed=\(passed) \(currentROIString)")
                    }
                }
                
                return passed
            }.sorted { $0.confidence > $1.confidence }
            
            // Update ROI based on detection — only for video-file processing, not live camera
            if self.videoURL != nil && self.settings.enableROI {
                if let bestDetection = baseballDetections.first {
                    self.updateROI(from: bestDetection.boundingBox)
                } else {
                    self.expandROI()
                }
            }

            // For video-file processing the CoreML callback drives the overlay update.
            // For live camera, captureOutput handles the overlay update explicitly after
            // handler.perform() so we skip the redundant dispatch here.
            if self.videoURL != nil {
                let bestDetection = baseballDetections.first
                DispatchQueue.main.async {
                    self.updateLiveOverlay(ballDetection: bestDetection)
                }
            }
        }
        request.imageCropAndScaleOption = VNImageCropAndScaleOption.scaleFill
        self.requests = [request]
        
        setupPoseEstimation()
        updatePoseROI()
    }
    
    // MARK: - Shared Overlay Update
    /// Clears and redraws all live overlay elements. Must be called on the main thread.
    func updateLiveOverlay(ballDetection: VNRecognizedObjectObservation? = nil) {
        overlayLayer.sublayers?.forEach { $0.removeFromSuperlayer() }
        let bufferSize = view.bounds.size

        if settings.ballDetectionEnabled, let detection = ballDetection {
            drawBoundingBox(detection.boundingBox,
                            bufferSize: bufferSize,
                            confidence: detection.confidence,
                            mirrored: mirrored,
                            contentFlippedVertically: contentFlippedVertically)
        }

        if let poseObs = lastPoseObservation, settings.poseEstimationEnabled {
            drawPoseSkeleton(poseObs, bufferSize: bufferSize)
        }

        if checkSwingDetected && settings.isCalibrated {
            drawCheckSwingIndicator(bufferSize: bufferSize)
        }

        if settings.isCalibrated {
            drawCalibrationOverlay(bufferSize: bufferSize)
        }

        if settings.isCalibrated && settings.showStrikeZone {
            drawStrikeZone(bufferSize: bufferSize)
        }

        // Only show ROI box in video-file mode (ROI is disabled for live camera)
        if videoURL != nil && settings.showROI, let roi = currentROI, settings.enableROI {
            drawROI(roi, bufferSize: bufferSize)
        }
    }

    func setupPoseEstimation() {
        poseRequest = VNDetectHumanBodyPoseRequest { [weak self] request, error in
            guard let self = self else { return }
            
            if let error = error {
                print("[Pose] Error: \(error.localizedDescription)")
                return
            }
            
            guard let observations = request.results as? [VNHumanBodyPoseObservation],
                  let observation = observations.first else { return }
            
            self.lastPoseObservation = observation

            // Check swing detection — runs on every pose update during recording
            if self.isRecording {
                self.evaluateCheckSwing(observation)
            }
            
            if let lastFrameTime = self.lastFrameTime {
                self.poseHistory.append((timestamp: lastFrameTime, observation: observation))
                
                let cutoffTime = CMTimeSubtract(lastFrameTime, CMTime(seconds: 5, preferredTimescale: 600))
                self.poseHistory.removeAll { CMTimeCompare($0.timestamp, cutoffTime) < 0 }
            }
            
            // When only pose is enabled (no ball detection) and processing a video file,
            // trigger the overlay redraw here. For live camera the overlay is updated
            // explicitly after handler.perform() in captureOutput.
            if !self.settings.ballDetectionEnabled && self.settings.poseEstimationEnabled && self.videoURL != nil {
                DispatchQueue.main.async {
                    self.updateLiveOverlay()
                }
            }
        }
    }

    // MARK: - Batter ROI

    /// Recalculates and applies the pose request's regionOfInterest so it only covers
    /// the batter's box on the correct side of the plate, excluding the catcher/umpire.
    ///
    /// Vision coordinate system: origin at bottom-left, Y increases upward.
    ///
    /// Strategy (with calibration):
    ///   - The right/left plate corner points define the plate width in normalised image space.
    ///   - A right-handed batter stands in the LEFT batter's box (from catcher's POV),
    ///     which is to the RIGHT in the camera image when shooting from behind the plate.
    ///   - We extend outward from the plate edge by ~1× plate width to cover the batter's box,
    ///     and use the full vertical range to cover the standing batter.
    ///
    /// Without calibration, falls back to the left or right half of the frame.
    func updatePoseROI() {
        guard let poseRequest = poseRequest else { return }

        guard let batter = activeBatter else {
            if settings.isCalibrated {
                // Calibrated but no batter selected: suppress pose entirely.
                // The catcher/umpire is behind the plate and shouldn't be tracked.
                poseRequest.regionOfInterest = CGRect(x: 0, y: 0, width: 0.001, height: 0.001)
                print("[Pose ROI] Calibrated, no active batter — pose suppressed")
            } else {
                // No calibration and no batter: search full frame
                poseRequest.regionOfInterest = CGRect(x: 0, y: 0, width: 1, height: 1)
                print("[Pose ROI] No calibration, no active batter — full frame")
            }
            return
        }

        // With 5-point calibration we can place the ROI precisely
        if settings.isCalibrated,
           settings.platePoints.count == 5,
           settings.platePoints[HomePlatePoint.right.rawValue] != .zero,
           settings.platePoints[HomePlatePoint.left.rawValue]  != .zero {

            // These are normalised image coords (0-1, origin top-left in UIKit).
            // We need to flip Y for Vision (origin bottom-left).
            let rightPt = settings.platePoints[HomePlatePoint.right.rawValue]
            let leftPt  = settings.platePoints[HomePlatePoint.left.rawValue]

            // Plate width in normalised image X units
            let plateNormWidth = abs(rightPt.x - leftPt.x)

            // The batter's box is 4 ft wide × 6 ft long. The plate is 17" = 1.417 ft wide.
            // Box width ≈ 2.8× plate width; use 1.5× as conservative ROI extension.
            let boxExtent = plateNormWidth * 1.5

            // RHB stands to the right of the plate in the camera (left batter's box in field terms).
            // LHB stands to the left of the plate in the camera (right batter's box in field terms).
            // Switch = treat as RHB for ROI purposes.
            let isRHB = (batter.handedness == .right || batter.handedness == .both)

            let roiMinX: CGFloat
            let roiMaxX: CGFloat

            if isRHB {
                // RHB: batter stands to the right of right plate corner (higher X)
                roiMinX = max(0, rightPt.x - plateNormWidth * 0.2)
                roiMaxX = min(1, rightPt.x + boxExtent)
            } else {
                // LHB: batter stands to the left of left plate corner (lower X)
                roiMinX = max(0, leftPt.x - boxExtent)
                roiMaxX = min(1, leftPt.x + plateNormWidth * 0.2)
            }

            // Vertical: cover the full height of the frame (batter is standing)
            // Vision Y is flipped: top of image = Y=0 in UIKit = Y=1 in Vision
            let roiVisionMinY: CGFloat = 0.0
            let roiVisionMaxY: CGFloat = 1.0

            let roi = CGRect(x: roiMinX,
                             y: roiVisionMinY,
                             width: roiMaxX - roiMinX,
                             height: roiVisionMaxY - roiVisionMinY)
            poseRequest.regionOfInterest = roi
            print(String(format: "[Pose ROI] %@ batter box: x=%.2f–%.2f",
                         isRHB ? "RHB" : "LHB", roiMinX, roiMaxX))

        } else {
            // No calibration — split frame in half horizontally.
            // Camera is behind the plate looking toward the pitcher, so:
            //   RHB batter's box is the RIGHT half of the image.
            //   LHB batter's box is the LEFT half of the image.
            let isRHB = (batter.handedness == .right || batter.handedness == .both)
            let roi: CGRect = isRHB
                ? CGRect(x: 0.5, y: 0, width: 0.5, height: 1.0)   // right half
                : CGRect(x: 0.0, y: 0, width: 0.5, height: 1.0)   // left half
            poseRequest.regionOfInterest = roi
            print("[Pose ROI] No calibration — \(isRHB ? "RHB" : "LHB") half-frame fallback")
        }
    }
    
    // MARK: - ROI Management
    
    /// Updates the ROI based on a successful ball detection
    func updateROI(from boundingBox: CGRect) {
        guard boundingBox.minX >= -0.1 && boundingBox.maxX <= 1.1 &&
              boundingBox.minY >= -0.1 && boundingBox.maxY <= 1.1 &&
              boundingBox.width > 0 && boundingBox.height > 0 &&
              boundingBox.width <= 1.0 && boundingBox.height <= 1.0 else {
            print("[ROI] ⚠️ Invalid bounding box detected: \(boundingBox) - ignoring")
            expandROI()
            return
        }
        
        if let existingROI = currentROI, framesWithoutDetection == 0 {
            let center = CGPoint(x: boundingBox.midX, y: boundingBox.midY)
            let expandedROI = existingROI.insetBy(dx: -existingROI.width * 0.5, dy: -existingROI.height * 0.5)
            if !expandedROI.contains(center) {
                print("[ROI] ⚠️ Detection too far from current ROI at 240fps, likely false positive - expanding instead")
                expandROI()
                return
            }
        }
        
        framesWithoutDetection = 0
        
        let centerX = max(0, min(1, boundingBox.midX))
        let centerY = max(0, min(1, boundingBox.midY))
        
        let baseROIWidth = max(boundingBox.width * initialROIScale, minROISize)
        let baseROIHeight = max(boundingBox.height * initialROIScale, minROISize)
        let roiWidth = min(baseROIWidth, 1.0)
        let roiHeight = min(baseROIHeight, 1.0)
        
        var roi = CGRect(
            x: centerX - roiWidth / 2,
            y: centerY - roiHeight / 2,
            width: roiWidth,
            height: roiHeight
        )
        
        roi = roi.intersection(CGRect(x: 0, y: 0, width: 1, height: 1))
        
        guard !roi.isEmpty else {
            print("[ROI] ⚠️ Empty ROI after clamping - resetting to full frame")
            currentROI = nil
            if let request = requests.first as? VNCoreMLRequest {
                request.regionOfInterest = CGRect(x: 0, y: 0, width: 1, height: 1)
            }
            return
        }
        
        currentROI = roi
        
        if let request = requests.first as? VNCoreMLRequest {
            request.regionOfInterest = roi
            
            if settings.showROI && frameCount % 60 == 0 {
                print("[ROI] ✅ Applied ROI to request: \(String(format: "x:%.3f y:%.3f w:%.3f h:%.3f", roi.origin.x, roi.origin.y, roi.width, roi.height))")
            }
        }
        
        if settings.showROI && frameCount % 30 == 0 {
            print("[ROI] ✅ Ball detected at 240fps: center(\(String(format: "%.3f,%.3f", centerX, centerY))) ball size(\(String(format: "%.3fx%.3f", boundingBox.width, boundingBox.height))) → ROI(\(String(format: "%.3fx%.3f", roi.width, roi.height)))")
        }
    }
    
    /// Expands the ROI when no ball is detected, or resets it after too many frames
    func expandROI() {
        framesWithoutDetection += 1
        
        if framesWithoutDetection >= maxFramesWithoutDetection {
            currentROI = nil
            if let request = requests.first as? VNCoreMLRequest {
                request.regionOfInterest = CGRect(x: 0, y: 0, width: 1, height: 1)
            }
            
            #if DEBUG
            if framesWithoutDetection == maxFramesWithoutDetection {
                print("[ROI] Reset to full frame after \(maxFramesWithoutDetection) frames")
            }
            #endif
            return
        }
        
        guard var roi = currentROI else { return }
        
        let newWidth = min(roi.width * roiExpansionRate, 1.0)
        let newHeight = min(roi.height * roiExpansionRate, 1.0)
        
        let averageSize = (newWidth + newHeight) / 2.0
        if averageSize >= maxROISize {
            print("[ROI] ROI expanded beyond max size (\(String(format: "%.2f", averageSize))), resetting to full frame")
            currentROI = nil
            framesWithoutDetection = maxFramesWithoutDetection
            if let request = requests.first as? VNCoreMLRequest {
                request.regionOfInterest = CGRect(x: 0, y: 0, width: 1, height: 1)
            }
            return
        }
        
        let centerX = roi.midX
        let centerY = roi.midY
        
        roi = CGRect(
            x: max(0, centerX - newWidth / 2),
            y: max(0, centerY - newHeight / 2),
            width: min(newWidth, 1.0),
            height: min(newHeight, 1.0)
        )
        
        roi = roi.intersection(CGRect(x: 0, y: 0, width: 1, height: 1))
        
        currentROI = roi
        
        if let request = requests.first as? VNCoreMLRequest {
            request.regionOfInterest = roi
        }
        
        #if DEBUG
        if framesWithoutDetection % 10 == 0 {
            print("[ROI] Expanded (\(framesWithoutDetection) frames): \(String(format: "%.3fx%.3f", roi.width, roi.height))")
        }
        #endif
    }
}
