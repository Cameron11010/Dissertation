//
//  VideoPreviewView.swift
//  Baseball Tracker
//
//  Pauses on the first frame of a selected video before processing,
//  allowing the user to calibrate all 5 home plate corners with
//  pinch-to-zoom and pan for precision.
//
//  Matches the same 5-point tap flow as CalibrationView (live camera).
//

import SwiftUI
import AVFoundation
import Photos

struct VideoPreviewView: View {
    let videoURL: URL
    let phAsset: PHAsset?
    @ObservedObject var settings: CameraSettings
    let onProcess: () -> Void
    let onCancel: () -> Void

    @State private var firstFrame: UIImage?
    @State private var isCalibrating = false

    // Zoom / pan state
    @State private var zoomScale: CGFloat = 1.0
    @State private var lastZoomScale: CGFloat = 1.0
    @State private var panOffset: CGSize = .zero
    @State private var lastPanOffset: CGSize = .zero

    // Five normalised image-space positions (nil = not yet placed)
    @State private var tappedPoints: [CGPoint?] = Array(repeating: nil, count: 5)

    // Layout
    @State private var containerSize: CGSize = .zero

    // Next point still waiting to be placed
    private var nextPointIndex: Int? {
        tappedPoints.firstIndex(where: { $0 == nil })
    }

    private var canSave: Bool { tappedPoints.allSatisfy { $0 != nil } }

    var body: some View {
        GeometryReader { geo in
            let imgSize = firstFrame?.size ?? CGSize(width: 1920, height: 1080)
            let fitRect = fitImageRect(imageSize: imgSize, in: geo.size)

            ZStack {
                Color.black.ignoresSafeArea()

                // Zoomable / pannable first frame
                if let image = firstFrame {
                    Image(uiImage: image)
                        .resizable()
                        .aspectRatio(contentMode: .fit)
                        .frame(width: fitRect.width, height: fitRect.height)
                        .scaleEffect(zoomScale)
                        .offset(panOffset)
                        .position(x: geo.size.width / 2, y: geo.size.height / 2)
                } else {
                    ProgressView("Loading preview…")
                        .foregroundColor(.white)
                }

                // Strike zone preview (shown when not calibrating and plate is set)
                if settings.isCalibrated && !isCalibrating, firstFrame != nil {
                    strikeZonePreview(fitRect: fitRect, containerSize: geo.size)
                }

                // Calibration overlays (markers + outline + tap target)
                if isCalibrating, firstFrame != nil {
                    calibrationOverlay(fitRect: fitRect, containerSize: geo.size)

                    // Live strike zone preview once we have the two corner points
                    if let rightNorm = tappedPoints[HomePlatePoint.right.rawValue],
                       let leftNorm  = tappedPoints[HomePlatePoint.left.rawValue] {
                        strikeZoneFromNorm(rightCorner: rightNorm, leftCorner: leftNorm,
                                           fitRect: fitRect, containerSize: geo.size)
                    }
                }

                // UI Controls
                VStack {
                    if !isCalibrating { topBar } else { calibrationHeader }
                    Spacer()
                    if isCalibrating { zoomLabel }
                    Spacer()
                    if !isCalibrating { bottomBar } else { calibrationControls }
                }
            }
            .onAppear {
                containerSize = geo.size
                extractFirstFrame()
            }
            .onChange(of: geo.size) { _, newSize in containerSize = newSize }
            .gesture(isCalibrating ? magnificationGesture : nil)
            .highPriorityGesture(isCalibrating && zoomScale > 1.05 ? dragPanGesture : nil)
        }
    }

    // MARK: - Gestures

    private var magnificationGesture: some Gesture {
        MagnificationGesture()
            .onChanged { scale in zoomScale = max(1.0, min(lastZoomScale * scale, 8.0)) }
            .onEnded { scale in
                zoomScale = max(1.0, min(lastZoomScale * scale, 8.0))
                lastZoomScale = zoomScale
                clampPan()
            }
    }

    private var dragPanGesture: some Gesture {
        DragGesture()
            .onChanged { value in
                panOffset = CGSize(width: lastPanOffset.width + value.translation.width,
                                   height: lastPanOffset.height + value.translation.height)
            }
            .onEnded { value in
                panOffset = CGSize(width: lastPanOffset.width + value.translation.width,
                                   height: lastPanOffset.height + value.translation.height)
                lastPanOffset = panOffset
                clampPan()
            }
    }

    private func clampPan() {
        let maxX = max(0, containerSize.width  * (zoomScale - 1) / 2)
        let maxY = max(0, containerSize.height * (zoomScale - 1) / 2)
        panOffset.width  = min(max(panOffset.width,  -maxX), maxX)
        panOffset.height = min(max(panOffset.height, -maxY), maxY)
        lastPanOffset = panOffset
    }

    // MARK: - Coordinate Conversion

    private func screenToNorm(_ screenPos: CGPoint, fitRect: CGRect, containerSize: CGSize) -> CGPoint {
        let imageCenter = CGPoint(x: containerSize.width  / 2 + panOffset.width,
                                  y: containerSize.height / 2 + panOffset.height)
        let scaledW = fitRect.width  * zoomScale
        let scaledH = fitRect.height * zoomScale
        let origin  = CGPoint(x: imageCenter.x - scaledW / 2, y: imageCenter.y - scaledH / 2)
        return CGPoint(x: (screenPos.x - origin.x) / scaledW,
                       y: (screenPos.y - origin.y) / scaledH)
    }

    private func normToScreen(_ norm: CGPoint, fitRect: CGRect, containerSize: CGSize) -> CGPoint {
        let imageCenter = CGPoint(x: containerSize.width  / 2 + panOffset.width,
                                  y: containerSize.height / 2 + panOffset.height)
        let scaledW = fitRect.width  * zoomScale
        let scaledH = fitRect.height * zoomScale
        let origin  = CGPoint(x: imageCenter.x - scaledW / 2, y: imageCenter.y - scaledH / 2)
        return CGPoint(x: origin.x + norm.x * scaledW, y: origin.y + norm.y * scaledH)
    }

    private func fitImageRect(imageSize: CGSize, in container: CGSize) -> CGRect {
        let scale = min(container.width / imageSize.width, container.height / imageSize.height)
        let w = imageSize.width * scale
        let h = imageSize.height * scale
        return CGRect(x: (container.width - w) / 2, y: (container.height - h) / 2, width: w, height: h)
    }

    // MARK: - Top Bar

    private var topBar: some View {
        HStack {
            Button(action: onCancel) {
                HStack(spacing: 6) {
                    Image(systemName: "chevron.left")
                    Text("Back")
                }
                .font(.headline)
                .foregroundColor(.white)
                .padding(.horizontal, 16)
                .padding(.vertical, 10)
                .background(Color.black.opacity(0.6))
                .cornerRadius(10)
            }

            Spacer()

            if settings.isCalibrated {
                HStack(spacing: 4) {
                    Image(systemName: "checkmark.circle.fill").foregroundColor(.green)
                    Text("Plate Calibrated").foregroundColor(.green)
                }
                .font(.subheadline.weight(.semibold))
                .padding(.horizontal, 12).padding(.vertical, 8)
                .background(Color.black.opacity(0.6))
                .cornerRadius(10)
            }
        }
        .padding()
    }

    // MARK: - Bottom Bar

    private var bottomBar: some View {
        VStack(spacing: 12) {
            HStack(spacing: 16) {
                Button {
                    loadExistingCalibration()
                    isCalibrating = true
                } label: {
                    HStack(spacing: 8) {
                        Image(systemName: "square.dashed")
                        Text(settings.isCalibrated ? "Edit Calibration" : "Calibrate Plate")
                    }
                    .font(.headline).foregroundColor(.white)
                    .frame(maxWidth: .infinity).padding()
                    .background(Color.blue.opacity(0.8)).cornerRadius(14)
                }

                Button(action: onProcess) {
                    HStack(spacing: 8) {
                        Image(systemName: "play.fill")
                        Text("Process Video")
                    }
                    .font(.headline).foregroundColor(.white)
                    .frame(maxWidth: .infinity).padding()
                    .background(Color.green.opacity(0.8)).cornerRadius(14)
                }
            }
        }
        .padding()
        .background(
            LinearGradient(colors: [.clear, .black.opacity(0.7)],
                           startPoint: .top, endPoint: .bottom)
                .ignoresSafeArea()
        )
    }

    // MARK: - Zoom Label

    private var zoomLabel: some View {
        HStack {
            Text(String(format: "%.1fx", zoomScale))
                .font(.subheadline.weight(.semibold))
                .foregroundColor(.white)
                .padding(.horizontal, 12).padding(.vertical, 6)
                .background(Color.black.opacity(0.6))
                .cornerRadius(8)
            Spacer()
        }
        .padding(.leading, 16)
    }

    // MARK: - Calibration Header

    private var calibrationHeader: some View {
        VStack(spacing: 6) {
            Text("Calibrate Home Plate")
                .font(.title2.weight(.bold))
                .foregroundColor(.white)
            Text(instructionText)
                .font(.subheadline)
                .foregroundColor(.white.opacity(0.9))
                .multilineTextAlignment(.center)
                .padding(.horizontal)
        }
        .padding()
        .frame(maxWidth: .infinity)
        .background(Color.black.opacity(0.7))
    }

    // MARK: - Calibration Overlay

    private func calibrationOverlay(fitRect: CGRect, containerSize: CGSize) -> some View {
        ZStack {
            // Tap target — fills the whole frame
            Color.clear
                .contentShape(Rectangle())
                .onTapGesture { location in
                    handleCalibrationTap(at: location, fitRect: fitRect, containerSize: containerSize)
                }

            // Placed markers
            ForEach(HomePlatePoint.allCases, id: \.rawValue) { pt in
                if let norm = tappedPoints[pt.rawValue] {
                    let pos = normToScreen(norm, fitRect: fitRect, containerSize: containerSize)
                    CalibrationMarker(label: pt.label, color: pt.color)
                        .position(pos)
                        .allowsHitTesting(false)
                }
            }

            // Pentagon outline connecting placed points in order
            plateOutline(fitRect: fitRect, containerSize: containerSize)
                .allowsHitTesting(false)
        }
    }

    @ViewBuilder
    private func plateOutline(fitRect: CGRect, containerSize: CGSize) -> some View {
        let screenPositions: [CGPoint] = HomePlatePoint.allCases.compactMap { pt in
            guard let norm = tappedPoints[pt.rawValue] else { return nil }
            return normToScreen(norm, fitRect: fitRect, containerSize: containerSize)
        }

        if screenPositions.count >= 2 {
            Canvas { ctx, _ in
                var path = Path()
                path.move(to: screenPositions[0])
                for i in 1..<screenPositions.count { path.addLine(to: screenPositions[i]) }
                if screenPositions.count == 5 { path.closeSubpath() }
                ctx.stroke(path, with: .color(.yellow.opacity(0.8)), lineWidth: 3)
            }
        }
    }

    // MARK: - Calibration Controls

    private var calibrationControls: some View {
        VStack(spacing: 12) {
            // Point progress strip
            HStack(spacing: 10) {
                ForEach(HomePlatePoint.allCases, id: \.rawValue) { pt in
                    VStack(spacing: 4) {
                        Circle()
                            .fill(tappedPoints[pt.rawValue] != nil ? pt.color : Color.gray.opacity(0.4))
                            .frame(width: 14, height: 14)
                            .overlay(Circle().stroke(Color.white, lineWidth: 1))
                        Text(pt.label)
                            .font(.system(size: 9, weight: .semibold))
                            .foregroundColor(.white)
                    }
                }
            }

            // Action buttons
            HStack(spacing: 12) {
                Button { clearCalibration() } label: {
                    Text("Clear")
                        .font(.headline).foregroundColor(.white)
                        .frame(maxWidth: .infinity).padding(12)
                        .background(Color.orange.opacity(0.7)).cornerRadius(10)
                }

                Button { resetZoom(); isCalibrating = false } label: {
                    Text("Cancel")
                        .font(.headline).foregroundColor(.white)
                        .frame(maxWidth: .infinity).padding(12)
                        .background(Color.red.opacity(0.7)).cornerRadius(10)
                }

                Button { saveCalibration() } label: {
                    Text("Save")
                        .font(.headline).foregroundColor(.white)
                        .frame(maxWidth: .infinity).padding(12)
                        .background(canSave ? Color.green : Color.gray.opacity(0.5)).cornerRadius(10)
                }
                .disabled(!canSave)
            }
        }
        .padding()
        .background(Color.black.opacity(0.8))
    }

    // MARK: - Strike Zone Previews
    // The ABS (Automated Ball-Strike) system strike zone width is defined by the
    // right corner (pt 2) and left corner (pt 4) of home plate — the 17" dimension
    // that runs across the widest part. This differs from the back edge (pts 0 & 1).

    private func strikeZonePreview(fitRect: CGRect, containerSize: CGSize) -> some View {
        // Use derived left/right edge from settings (back-left / back-right) for strike zone sides,
        // but use right corner and left corner for the actual width.
        // If we have all 5 points use them; fall back to the legacy two-point data.
        let rightNorm: CGPoint
        let leftNorm: CGPoint

        if settings.platePoints.count == 5 &&
           settings.platePoints[HomePlatePoint.right.rawValue] != .zero &&
           settings.platePoints[HomePlatePoint.left.rawValue]  != .zero {
            rightNorm = settings.platePoints[HomePlatePoint.right.rawValue]
            leftNorm  = settings.platePoints[HomePlatePoint.left.rawValue]
        } else {
            rightNorm = settings.plateRightEdge
            leftNorm  = settings.plateLeftEdge
        }

        return strikeZoneFromNorm(rightCorner: rightNorm, leftCorner: leftNorm,
                                  fitRect: fitRect, containerSize: containerSize)
    }

    @discardableResult
    private func strikeZoneFromNorm(rightCorner: CGPoint, leftCorner: CGPoint,
                                    fitRect: CGRect, containerSize: CGSize) -> some View {
        Canvas { context, _ in
            let right = normToScreen(rightCorner, fitRect: fitRect, containerSize: containerSize)
            let left  = normToScreen(leftCorner,  fitRect: fitRect, containerSize: containerSize)

            let plateVec   = CGPoint(x: right.x - left.x, y: right.y - left.y)
            let platePixels = hypot(plateVec.x, plateVec.y)
            guard platePixels > 1 else { return }

            // 17" is the plate width in both the back-edge and the right/left corner measurement
            let plateInches = settings.useCentimeters ? settings.plateWidth / 2.54 : settings.plateWidth
            let ppi = platePixels / plateInches

            let upUnit = CGPoint(x: 0, y: -1)   // screen up
            let bottomOffset = ppi * settings.strikeZoneBottomOffset
            let zoneHeight   = ppi * settings.strikeZoneHeight

            let bl = CGPoint(x: left.x  + upUnit.x * bottomOffset, y: left.y  + upUnit.y * bottomOffset)
            let br = CGPoint(x: right.x + upUnit.x * bottomOffset, y: right.y + upUnit.y * bottomOffset)
            let tl = CGPoint(x: left.x  + upUnit.x * (bottomOffset + zoneHeight),
                             y: left.y  + upUnit.y * (bottomOffset + zoneHeight))
            let tr = CGPoint(x: right.x + upUnit.x * (bottomOffset + zoneHeight),
                             y: right.y + upUnit.y * (bottomOffset + zoneHeight))

            var fill = Path()
            fill.move(to: bl); fill.addLine(to: br); fill.addLine(to: tr); fill.addLine(to: tl)
            fill.closeSubpath()
            context.fill(fill, with: .color(.white.opacity(0.08)))
            context.stroke(fill, with: .color(.white.opacity(0.6)), lineWidth: 2)

            var mid = Path()
            mid.move(to:    CGPoint(x: (bl.x + tl.x) / 2, y: (bl.y + tl.y) / 2))
            mid.addLine(to: CGPoint(x: (br.x + tr.x) / 2, y: (br.y + tr.y) / 2))
            context.stroke(mid, with: .color(.white.opacity(0.3)),
                           style: StrokeStyle(lineWidth: 1, dash: [6, 4]))
        }
        .allowsHitTesting(false)
    }

    // MARK: - Helpers

    private var instructionText: String {
        guard let idx = nextPointIndex, let pt = HomePlatePoint(rawValue: idx) else {
            return "All 5 points placed. Pinch to verify, then tap Save."
        }
        return "Step \(idx + 1)/5 — Tap the \(pt.label) corner of home plate"
    }

    private func handleCalibrationTap(at position: CGPoint, fitRect: CGRect, containerSize: CGSize) {
        let norm = screenToNorm(position, fitRect: fitRect, containerSize: containerSize)
        guard norm.x >= -0.05 && norm.x <= 1.05 && norm.y >= -0.05 && norm.y <= 1.05 else { return }

        if let idx = nextPointIndex {
            tappedPoints[idx] = norm
        } else {
            // All 5 placed — tap again resets
            clearCalibration()
        }
    }

    private func loadExistingCalibration() {
        if settings.isCalibrated && settings.platePoints.count == 5 {
            tappedPoints = settings.platePoints.map { $0 == .zero ? nil : $0 }
        } else {
            tappedPoints = Array(repeating: nil, count: 5)
        }
    }

    private func clearCalibration() {
        tappedPoints = Array(repeating: nil, count: 5)
        settings.isCalibrated = false
        settings.platePoints  = Array(repeating: .zero, count: 5)
        settings.plateLeftEdge  = .zero
        settings.plateRightEdge = .zero
    }

    private func saveCalibration() {
        guard canSave else { return }

        let points = tappedPoints.map { $0! }   // safe — canSave checks all non-nil

        settings.platePoints    = points
        settings.isCalibrated   = true
        settings.plateWidth     = 17.0

        // Derive legacy edges from back-left and back-right for backward-compat
        settings.plateLeftEdge  = points[HomePlatePoint.backLeft.rawValue]
        settings.plateRightEdge = points[HomePlatePoint.backRight.rawValue]
        settings.useCentimeters = false

        resetZoom()
        isCalibrating = false
    }

    private func resetZoom() {
        zoomScale = 1.0; lastZoomScale = 1.0
        panOffset = .zero; lastPanOffset = .zero
    }

    private func extractFirstFrame() {
        let asset     = AVURLAsset(url: videoURL)
        let generator = AVAssetImageGenerator(asset: asset)
        generator.appliesPreferredTrackTransform = true
        generator.requestedTimeToleranceBefore   = .zero
        generator.requestedTimeToleranceAfter    = CMTime(seconds: 0.1, preferredTimescale: 600)

        generator.generateCGImagesAsynchronously(
            forTimes: [NSValue(time: CMTime(seconds: 0, preferredTimescale: 600))]
        ) { _, cgImage, _, _, _ in
            if let cgImage = cgImage {
                let image = UIImage(cgImage: cgImage)
                DispatchQueue.main.async { self.firstFrame = image }
            }
        }
    }
}
