    // MARK: - Joint Angle Calculation
    func calculateJointAngle(proximal: CGPoint, joint: CGPoint, distal: CGPoint) -> Double {
        let vector1 = CGPoint(x: proximal.x - joint.x, y: proximal.y - joint.y)
        let vector2 = CGPoint(x: distal.x - joint.x, y: distal.y - joint.y)
        
        let dot = vector1.x * vector2.x + vector1.y * vector2.y
        let mag1 = sqrt(vector1.x * vector1.x + vector1.y * vector1.y)
        let mag2 = sqrt(vector2.x * vector2.x + vector2.y * vector2.y)
        
        guard mag1 > 0, mag2 > 0 else { return 0 }
        
        let cosAngle = max(-1, min(1, dot / (mag1 * mag2)))
        return acos(cosAngle) * 180.0 / .pi
    }
    
    // MARK: - Dynamic Calibration from Ball Size
    func estimatePixelsPerFootFromBall(boundingBox: CGRect, viewSize: CGSize) -> Double? {
        let baseballDiameterInFeet = 0.242
        
        let boxWidth = boundingBox.width * viewSize.width
        let boxHeight = boundingBox.height * viewSize.height
        let avgBallSizeInPixels = (boxWidth + boxHeight) / 2.0
        
        guard avgBallSizeInPixels >= 10 && avgBallSizeInPixels <= 200 else {
            print("[Calibration Debug] Ball size out of range (10-200px), rejecting")
            return nil
        }
        
        let rawPixelsPerFoot = avgBallSizeInPixels / baseballDiameterInFeet
        let pixelsPerFoot = rawPixelsPerFoot
        print("[Calibration Debug] Ball box: \(String(format: "%.1f", boxWidth))px × \(String(format: "%.1f", boxHeight))px, avg: \(String(format: "%.1f", avgBallSizeInPixels))px, lens: \(String(format: "%.1f", settings.selectedLens))x")
        print("[Calibration Debug] Calculated pixels/ft: \(String(format: "%.1f", pixelsPerFoot))")
        
        guard pixelsPerFoot >= 10 && pixelsPerFoot <= 500 else {
            print("[Calibration Debug] Pixels/ft out of range (10-500), rejecting: \(String(format: "%.1f", pixelsPerFoot))")
            return nil
        }
        
        return pixelsPerFoot
    }
    
    // MARK: - Biomechanical Analysis
    func analyzeBiomechanics(ballPosition: CGPoint, poseObservation: VNHumanBodyPoseObservation, viewSize: CGSize? = nil) -> [String: Any] {
        guard let recognizedPoints = try? poseObservation.recognizedPoints(.all) else { return [:] }
        
        let pixelSize: CGSize
        if let provided = viewSize {
            pixelSize = provided
        } else {
            let orientation = UIDevice.current.orientation
            let isPortrait = orientation == .portrait || orientation == .portraitUpsideDown
            if isPortrait {
                pixelSize = CGSize(width: CGFloat(activeDimensions.height), height: CGFloat(activeDimensions.width))
            } else {
                pixelSize = CGSize(width: CGFloat(activeDimensions.width), height: CGFloat(activeDimensions.height))
            }
        }
        
        func toPixels(_ pt: CGPoint) -> CGPoint {
            return CGPoint(x: pt.x * pixelSize.width, y: pt.y * pixelSize.height)
        }
        
        var analysis: [String: Any] = [:]
        
        // Elbow angles
        if let rS = recognizedPoints[.rightShoulder], let rE = recognizedPoints[.rightElbow], let rW = recognizedPoints[.rightWrist],
           rS.confidence > 0.5, rE.confidence > 0.5, rW.confidence > 0.5 {
            analysis["rightElbowAngle"] = calculateJointAngle(proximal: toPixels(rS.location), joint: toPixels(rE.location), distal: toPixels(rW.location))
        }
        if let lS = recognizedPoints[.leftShoulder], let lE = recognizedPoints[.leftElbow], let lW = recognizedPoints[.leftWrist],
           lS.confidence > 0.5, lE.confidence > 0.5, lW.confidence > 0.5 {
            analysis["leftElbowAngle"] = calculateJointAngle(proximal: toPixels(lS.location), joint: toPixels(lE.location), distal: toPixels(lW.location))
        }
        
        // Knee angles
        if let rH = recognizedPoints[.rightHip], let rK = recognizedPoints[.rightKnee], let rA = recognizedPoints[.rightAnkle],
           rH.confidence > 0.5, rK.confidence > 0.5, rA.confidence > 0.5 {
            analysis["rightKneeAngle"] = calculateJointAngle(proximal: toPixels(rH.location), joint: toPixels(rK.location), distal: toPixels(rA.location))
        }
        if let lH = recognizedPoints[.leftHip], let lK = recognizedPoints[.leftKnee], let lA = recognizedPoints[.leftAnkle],
           lH.confidence > 0.5, lK.confidence > 0.5, lA.confidence > 0.5 {
            analysis["leftKneeAngle"] = calculateJointAngle(proximal: toPixels(lH.location), joint: toPixels(lK.location), distal: toPixels(lA.location))
        }
        
        // Shoulder angles
        if let rS = recognizedPoints[.rightShoulder], let rH = recognizedPoints[.rightHip], let rE = recognizedPoints[.rightElbow],
           rS.confidence > 0.5, rH.confidence > 0.5, rE.confidence > 0.5 {
            analysis["rightShoulderAngle"] = calculateJointAngle(proximal: toPixels(rH.location), joint: toPixels(rS.location), distal: toPixels(rE.location))
        }
        if let lS = recognizedPoints[.leftShoulder], let lH = recognizedPoints[.leftHip], let lE = recognizedPoints[.leftElbow],
           lS.confidence > 0.5, lH.confidence > 0.5, lE.confidence > 0.5 {
            analysis["leftShoulderAngle"] = calculateJointAngle(proximal: toPixels(lH.location), joint: toPixels(lS.location), distal: toPixels(lE.location))
        }
        
        // Wrist-to-ball distances
        if let rW = recognizedPoints[.rightWrist], rW.confidence > 0.5 {
            let d = sqrt(pow(ballPosition.x - rW.location.x, 2) + pow(ballPosition.y - rW.location.y, 2))
            analysis["rightWristToBallDistance"] = d
        }
        if let lW = recognizedPoints[.leftWrist], lW.confidence > 0.5 {
            let d = sqrt(pow(ballPosition.x - lW.location.x, 2) + pow(ballPosition.y - lW.location.y, 2))
            analysis["leftWristToBallDistance"] = d
        }
        
        analysis["ballPosition"] = ballPosition
        return analysis
    }
    
    // MARK: - Export Biomechanical Data
    func exportBiomechanicalData() -> String {
        var csv = "Timestamp,BallX,BallY,RightElbowAngle,LeftElbowAngle,RightKneeAngle,LeftKneeAngle,RightShoulderAngle,LeftShoulderAngle,RightWristDistance,LeftWristDistance\n"
        
        for frameData in fusedFrameData {
            let timestamp = CMTimeGetSeconds(frameData.timestamp)
            let ballPos = frameData.ballPosition
            
            if let poseObs = frameData.poseObservation, let ballPosition = ballPos {
                let a = analyzeBiomechanics(ballPosition: ballPosition, poseObservation: poseObs)
                csv += "\(timestamp),\(ballPosition.x),\(ballPosition.y),"
                csv += "\(a["rightElbowAngle"] as? Double ?? 0),\(a["leftElbowAngle"] as? Double ?? 0),"
                csv += "\(a["rightKneeAngle"] as? Double ?? 0),\(a["leftKneeAngle"] as? Double ?? 0),"
                csv += "\(a["rightShoulderAngle"] as? Double ?? 0),\(a["leftShoulderAngle"] as? Double ?? 0),"
                csv += "\(a["rightWristToBallDistance"] as? Double ?? 0),\(a["leftWristToBallDistance"] as? Double ?? 0)\n"
            } else if let ballPosition = ballPos {
                csv += "\(timestamp),\(ballPosition.x),\(ballPosition.y),0,0,0,0,0,0,0,0\n"
            }
        }
        
        return csv
    }
    
    // MARK: - Check Swing Detection

    /// Evaluates a single pose frame for check-swing criteria.
    ///
    /// A check swing is flagged when ANY of the following conditions are met:
    ///   1. **Bat angle ≥ 45°** — the vector from trail wrist to lead wrist makes an angle of
    ///      at least 45° toward the pitcher (i.e. the hands have committed forward far enough
    ///      that the bat head has passed the front of the plate).
    ///   2. **Wrist roll** — the trail wrist's X position overtakes the lead wrist's X position
    ///      in two or more consecutive frames, indicating the batter has rolled their wrists
    ///      through the contact zone.
    ///   3. **Bat crosses body** — the lead wrist passes the body midline (mid-hip X) toward
    ///      the pitcher side, meaning the bat barrel has crossed in front of the batter's body.
    ///
    /// All coordinates are in Vision normalised space (0-1, origin bottom-left).
    /// The caller is responsible for clearing `checkSwingDetected` between pitches.
    func evaluateCheckSwing(_ obs: VNHumanBodyPoseObservation) {
        guard !checkSwingDetected else { return }   // already flagged this pitch
        guard settings.isCalibrated else { return } // strike zone must be calibrated
        guard let pts = try? obs.recognizedPoints(.all) else { return }

        let conf = settings.poseConfidenceThreshold
        let batter = activeBatter

        // Determine which wrist is the "lead" (top hand, closest to barrel) and "trail" (bottom hand).
        //
        // Cameras are placed on the foul lines (1st base or 3rd base side), so the batter
        // is seen side-on. The lead hand is the top hand on the bat:
        //   RHB: left hand is on top (lead)
        //   LHB: right hand is on top (lead)
        //
        // We confirm the camera's orientation using the plate calibration:
        //   platePoints[right corner] world X = +8.5" (toward first base)
        //   platePoints[left corner]  world X = -8.5"
        // If right corner image X > left corner image X, first base is on the image right
        // → 3rd base camera. Otherwise 1st base camera.
        // In both foul-line cases the lead/trail assignment is the same (opposite to handedness),
        // but if calibration is unavailable we fall back to that same assumption.
        let isRHB = (batter?.handedness ?? .right) != .left

        // Verify orientation from calibration if available (sanity check only — assignment
        // is the same from either foul line for a side-on view).
        if settings.isCalibrated, settings.platePoints.count == 5 {
            let rightCornerImageX = settings.platePoints[HomePlatePoint.right.rawValue].x
            let leftCornerImageX  = settings.platePoints[HomePlatePoint.left.rawValue].x
            let firstBaseOnRight  = rightCornerImageX > leftCornerImageX
            // Log so we can verify the camera side during development
            print("[CheckSwing] Camera side: \(firstBaseOnRight ? "3rd base" : "1st base") foul line")
        }

        guard let rwPt = pts[.rightWrist], let lwPt = pts[.leftWrist],
              rwPt.confidence > conf, lwPt.confidence > conf else { return }

        // Lead wrist = top hand = opposite side to handedness
        // RHB: left wrist leads. LHB: right wrist leads.
        let leadWrist  = isRHB ? lwPt.location : rwPt.location
        let trailWrist = isRHB ? rwPt.location : lwPt.location

        // ── Criterion 1: Bat angle ≥ 45° ──────────────────────────────────────────
        // The bat vector runs from trail wrist to lead wrist.
        // "Forward" in the image means increasing X (toward first base from catcher's view).
        // Angle is measured from vertical (Y axis). 45° means the hands have gone
        // far enough that the bat's path is nearly horizontal — a committed swing plane.
        let batDx = leadWrist.x - trailWrist.x
        let batDy = leadWrist.y - trailWrist.y
        let batAngleDeg = atan2(abs(batDx), max(abs(batDy), 0.001)) * 180.0 / .pi

        if batAngleDeg >= 45.0 {
            checkSwingDetected = true
            print(String(format: "[CheckSwing] ✅ Bat angle %.1f° ≥ 45° — check swing", batAngleDeg))
            return
        }

        // ── Criterion 2: Wrist roll ────────────────────────────────────────────────
        // Trail wrist X overtaking lead wrist X means the hands have rolled through
        // the hitting zone. Track last 3 frames; flag when it happens twice in a row.
        wristXHistory.append((leadWrist: leadWrist.x, trailWrist: trailWrist.x))
        if wristXHistory.count > 5 { wristXHistory.removeFirst() }

        if wristXHistory.count >= 2 {
            // Count consecutive frames where trail X ≥ lead X (wrists have crossed).
            // From a foul line camera both wrists are at similar depth, so their X positions
            // crossing is a reasonable proxy for wrist roll regardless of which side the
            // camera is on — the trail wrist overtakes the lead wrist horizontally as the
            // batter rolls through contact.
            // RHB: lead = left wrist. Normally trail(right) X is behind lead(left) X toward
            //      the pitcher. Roll = trail X overtakes lead X.
            // LHB: lead = right wrist. Mirror image — same crossing condition applies.
            var rolledCount = 0
            for sample in wristXHistory.suffix(3) {
                if isRHB {
                    // RHB: normally trail(right) X < lead(left) X. Roll = trail overtakes lead.
                    if sample.trailWrist >= sample.leadWrist { rolledCount += 1 }
                } else {
                    // LHB: normally trail(left) X > lead(right) X. Roll = trail goes below lead.
                    if sample.trailWrist <= sample.leadWrist { rolledCount += 1 }
                }
            }
            if rolledCount >= 2 {
                checkSwingDetected = true
                print("[CheckSwing] ✅ Wrist roll detected (\(rolledCount) consecutive frames) — check swing")
                return
            }
        }

        // ── Criterion 3: Bat crosses front of body ────────────────────────────────
        // The lead wrist passes the body midline (average hip X) toward the pitcher,
        // meaning the bat barrel has swung past in front of the batter.
        if let rhPt = pts[.rightHip], let lhPt = pts[.leftHip],
           rhPt.confidence > conf, lhPt.confidence > conf {
            let hipMidX = (rhPt.location.x + lhPt.location.x) / 2.0
            // RHB: lead wrist (right) crossing below hip midline means it passed in front.
            // LHB: lead wrist (left) crossing above hip midline means it passed in front.
            let crossed = isRHB
                ? leadWrist.x < hipMidX - 0.03   // right wrist past center toward left
                : leadWrist.x > hipMidX + 0.03   // left wrist past center toward right

            if crossed {
                checkSwingDetected = true
                print(String(format: "[CheckSwing] ✅ Bat crossed front of body (leadX=%.2f hipMidX=%.2f) — check swing",
                             leadWrist.x, hipMidX))
                return
            }
        }
    }

    func saveBiomechanicalDataToFile() {
        let csv = exportBiomechanicalData()
        let fileName = "biomechanics_\(UUID().uuidString).csv"
        let fileURL = FileManager.default.temporaryDirectory.appendingPathComponent(fileName)
        
        do {
            try csv.write(to: fileURL, atomically: true, encoding: .utf8)
            print("[Biomechanics] Exported data to: \(fileURL.path)")
            print("[Biomechanics] Total frames analyzed: \(fusedFrameData.count)")
        } catch {
            print("[Biomechanics] Error saving CSV: \(error)")
        }
    }

    // MARK: - Skeleton Frame Builder

    /// Convert a VNHumanBodyPoseObservation into a SkeletonFrame using normalised Vision coordinates.
    /// Points with confidence below the threshold are stored as nil.
    func makeSkeletonFrame(from obs: VNHumanBodyPoseObservation, timestamp: Double) -> SkeletonFrame {
        let threshold = settings.poseConfidenceThreshold
        guard let pts = try? obs.recognizedPoints(.all) else {
            return SkeletonFrame(timestamp: timestamp, joints: SkeletonJoints())
        }
        func pt(_ name: VNHumanBodyPoseObservation.JointName) -> CGPoint? {
            guard let p = pts[name], p.confidence > threshold else { return nil }
            return p.location
        }
        let joints = SkeletonJoints(
            neck:           pt(.neck),
            leftShoulder:   pt(.leftShoulder),
            rightShoulder:  pt(.rightShoulder),
            leftElbow:      pt(.leftElbow),
            rightElbow:     pt(.rightElbow),
            leftWrist:      pt(.leftWrist),
            rightWrist:     pt(.rightWrist),
            leftHip:        pt(.leftHip),
            rightHip:       pt(.rightHip),
            leftKnee:       pt(.leftKnee),
            rightKnee:      pt(.rightKnee),
            leftAnkle:      pt(.leftAnkle),
            rightAnkle:     pt(.rightAnkle)
        )
        return SkeletonFrame(timestamp: timestamp, joints: joints)
    }
}
